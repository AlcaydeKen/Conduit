{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "verify:ordering": "tsx --env-file=.env.local scripts/verify-ordering.ts",
    "verify:api": "tsx --env-file=.env.local scripts/verify-api.ts",
    "verify:filters": "tsx scripts/verify-filters.ts",
    "verify:tenant": "tsx --env-file=.env.local scripts/verify-tenant.ts",
    "verify:sprints": "tsx --env-file=.env.local scripts/verify-sprints.ts",
    "verify:mcp": "tsx --env-file=.env.local scripts/verify-mcp.ts",
    "mcp:build": "pnpm --filter conduit-mcp build",
    "verify:queue": "tsx --env-file=.env.local scripts/verify-queue.ts",
    "claim-key:mint": "tsx --env-file=.env.local scripts/mint-claim-key.ts",
    "queue:status": "tsx --env-file=.env.local scripts/queue-status.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "fractional-indexing": "^4.0.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@auth/core": "0.40.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
