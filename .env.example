# Neon Postgres connection string (pooled URL is fine for the HTTP driver)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/koban?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth app
#   Homepage URL:              http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The only three humans allowed to sign in. First address becomes workspace owner.
ALLOWED_EMAILS="you@example.com,dev2@example.com,dev3@example.com"
