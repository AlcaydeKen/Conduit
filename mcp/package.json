{
  "name": "conduit-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "conduit-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file=../.env.local dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  }
}
